# Copy this file to .env and fill in real values before running.

# Password for the /admin panel. Anyone with this can add matches, enter
# results, adjust the pot, and see who owes money / how payouts split.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin login session cookie.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me

# Random secret used to build the one-way lookup hash that recognises a
# returning predictor by their cellphone number (for season stats). It is
# NOT the encryption key and cannot be used to recover phone numbers.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
PHONE_HASH_SECRET=change-me

# Encryption key for the (recoverable, admin-only, never web-exposed) stored
# phone number. Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHONE_ENCRYPTION_KEY=change-me

# Default country code used to normalize numbers typed with a leading 0
# (e.g. 082 123 4567 -> 27821234567). Change if your group isn't in SA.
DEFAULT_COUNTRY_CODE=27

# Timezone kickoff times are entered/displayed in, and used to decide when
# predictions lock. Any IANA name (e.g. Africa/Johannesburg, Europe/London).
APP_TIMEZONE=Africa/Johannesburg
